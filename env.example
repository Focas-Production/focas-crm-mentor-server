# Database Configuration
MONGO_URI=mongodb://localhost:27017/your_database_name

# Server Configuration
PORT=3000

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=your_aws_region_here
AWS_S3_BUCKET=your_s3_bucket_name_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# OpenAI Configuration (if using)
OPENAI_API_KEY=your_openai_api_key_here

# The OTHER bot's trigger word.
#
# The drip engine (Focas/drip_engine) runs its own quiz on this same wacrm
# account, started by this word — `quiz` by default, set there as the
# `quizTrigger` keeper setting. Both servers receive every inbound message on
# this number, so without this they both answer it and the learner gets two
# bots talking over each other.
#
# This server stays silent on this exact word. Its own trigger, `mcq`, is
# unaffected. Keep this in step with the drip engine's setting — if they drift,
# this server starts answering the other bot's word again.
QUIZ_TRIGGER_WORD=quiz
